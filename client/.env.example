# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PI_BRIDGE_KEY: Shared secret the Raspberry Pi 4 bridge uses to authenticate to this server.
# Must match PI_BRIDGE_KEY on the Pi. Without it the Pi is rejected and models cannot be controlled.
PI_BRIDGE_KEY="change-me"

# SUPABASE_SERVICE_ROLE_KEY (optional, server-side only, NEVER expose to the browser):
# lets the model scheduler read exams / exam_students without a user session if RLS blocks the anon key.
SUPABASE_SERVICE_ROLE_KEY=""
